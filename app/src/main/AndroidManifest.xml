<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<!-- Internet access සඳහා -->
<uses-permission android:name="android.permission.INTERNET" />
<!-- Background එකේ දිගටම දුවන්න අවශ්‍ය permissions -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<uses-permission android:name="android.permission.WAKE_LOCK" />
<!-- App එකේ ප්‍රධාන සැකසුම් සහ Icon එක -->
<application
android:allowBackup="true"
android:icon="@android:drawable/sym_def_app_icon"
android:label="Keep Alive"
android:roundIcon="@android:drawable/sym_def_app_icon"
android:supportsRtl="true"
android:theme="@style/Theme.PingKeepAlive">
<!-- App එක Open කරද්දී එන Main UI එක -->
<activity
android:name=".MainActivity"
android:exported="true">
<intent-filter>
<action android:name="android.intent.action.MAIN" />
<category android:name="android.intent.category.LAUNCHER" />
</intent-filter>
</activity>
<!-- Phone එක sleep වුණත් Ping එක යවන Service එක -->
<service
android:name=".PingService"
android:exported="false"
android:foregroundServiceType="dataSync" />
</application>
</manifest>
